# Optional. Shipyard runs without a .env file. Copy this file to .env only to
# change a default below:
#   cp .env.example .env && chmod 600 .env

# Pin a release (recommended for production), e.g.
# SHIPYARD_IMAGE=ghcr.io/tobayashi-san/shipyard:1.2.3
SHIPYARD_IMAGE=ghcr.io/tobayashi-san/shipyard:latest

# Compose binds to localhost by default. Change only to a private-LAN address
# when access is protected by a firewall or VPN.
SHIPYARD_BIND_ADDRESS=127.0.0.1
SHIPYARD_PORT=443

TZ=Europe/Zurich
SHIPYARD_TIMEZONE=Europe/Zurich

# Optional maximum size for one SFTP upload or host-to-host transfer (1 GiB).
# SHIPYARD_MAX_FILE_TRANSFER_BYTES=1073741824

# Optional: only set these for the appropriate deployment topology.
# CERT_SANS=IP:10.20.1.10,DNS:shipyard.example.internal
# ALLOWED_ORIGINS=https://shipyard.example.internal
# TRUST_PROXY=1

# One-time renewal of Shipyard's generated certificate after changing CERT_SANS.
# Set to 1, recreate the container, then reset to 0 and recreate it again.
# Existing generated key/certificate files are archived before replacement.
# Managed agents may need the renewed certificate trust updated; see deployment docs.
# SHIPYARD_RENEW_CERT=0

# Optional. When empty, Shipyard generates both secrets on first start and keeps
# them in the shipyard-secrets volume. Values set here take precedence; existing
# installations must keep their current values. Never commit or share them, and
# keep SHIPYARD_KEY_SECRET stable: changing it prevents decrypting stored keys.
JWT_SECRET=
SHIPYARD_KEY_SECRET=

# Interactive SSH session limits in minutes (0 disables a limit; maximum 10080).
# Applied to new sessions. Output does not reset idle time; expiry disconnects
# the shell and can interrupt foreground commands. Use managed runs for long jobs.
SHIPYARD_TERMINAL_IDLE_MINUTES=30
SHIPYARD_TERMINAL_MAX_MINUTES=480

# Require MFA: optional (default), admins, or all.
# Affected users receive a restricted 10-minute enrollment session until TOTP is confirmed.
# Unrecognized nonempty values enforce all. Existing password-only sessions must reauthenticate/enroll.
SHIPYARD_MFA_POLICY=optional
