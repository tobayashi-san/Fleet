{
  "name": "fleet-server",
  "version": "3.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Fleet Backend API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
