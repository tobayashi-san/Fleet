    "express-rate-limit": "^8.7.0",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "node-ssh": "^13.2.1",
    "nodemailer": "^10.0.10",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "uuid": "^14.0.2",
    "ws": "^8.20.1"
  },
  "overrides": {
    "qs": "^6.16.0"
